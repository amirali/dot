{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "agent": {
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "right",
  },
  "ui_font_family": "Iosevka",
  "buffer_font_family": "Iosevka",
  "use_system_path_prompts": false,
  "use_system_prompts": false,
  "terminal": {
    "font_family": "Iosevka",
  },
  "proxy": "http://127.0.0.1:10808",
  "session": {
    "trust_all_worktrees": false,
  },
  "base_keymap": "Zed",
  "agent_servers": {
    "cursor": {
      "type": "registry",
    },
    "github-copilot-cli": {
      "favorite_config_option_values": {
        "model": [
          "gpt-5.4-mini",
          "claude-sonnet-5",
          "mai-code-1.1-flash",
          "auto",
          "gpt-5-mini",
        ],
      },
      "default_config_options": {
        "allow_all": "on",
        "mode": "https://agentclientprotocol.com/protocol/session-modes#agent",
        "agent": "",
        "model": "gpt-5-mini",
      },
      "type": "registry",
    },
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Frappé",
    "dark": "Catppuccin Macchiato",
  },
  "theme": {
    "mode": "dark",
    "light": "Nord Light",
    "dark": "Nord Dark",
  },
  "vim_mode": true,
  "show_line_numbers": true,
  "relative_line_numbers": "enabled",
  "cursorline": true,
  "scrollbar": {
    "show": "always",
  },
  "soft_wrap": "editor_width",
  "preferred_line_length": 80,
  "show_wrap_guides": true,
  "tab_size": 2,
  "hard_tabs": false,
  "format_on_save": "on",
  "autosave": "on_focus_change",
  "confirm_quit": false,
  "auto_indent_on_paste": true,
  "inlay_hints": {
    "enabled": true,
  },
}
