{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,

    "modules-left": ["sway/workspaces", "sway/mode", "sway/scratchpad", "sway/window"],
    "modules-center": ["clock"],
    "modules-right": ["mpd", "sway/language", "idle_inhibitor", "pulseaudio", "network", "bluetooth", "cpu", "memory", "backlight", "battery", "tray"],

    "sway/workspaces": {
        "format": "{name}",
        "disable-scroll": true,
        "on-click": "activate"
    },
    "sway/window": {
        "max-length": 60
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/scratchpad": {
        "format": "scratch {count}",
        "show-empty": false
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "on-click": "ghostty -e calcurse"
    },

    "mpd": {
        "format": "{stateIcon} {artist} - {title}",
        "format-stopped": "music stopped",
        "format-disconnected": "music offline",
        "state-icons": {
            "paused": "pause",
            "playing": "play"
        },
        "max-length": 35,
        "on-click": "ghostty -e rmpc",
        "on-click-right": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "sway/language": {
        "format": "kbd {short}",
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    },

    "idle_inhibitor": {
        "format": "idle {status}",
        "format-icons": {
            "activated": "on",
            "deactivated": "off"
        }
    },

    "pulseaudio": {
        "format": "vol {volume}%",
        "format-muted": "vol muted",
        "on-click": "ghostty -e wiremix",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "network": {
        "format-wifi": "wifi {signalStrength}%",
        "format-ethernet": "lan {ifname}",
        "format-disconnected": "net offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "ghostty -e nmtui"
    },

    "bluetooth": {
        "format": "bt {status}",
        "format-connected": "bt {num_connections}",
        "on-click": "ghostty -e bluetoothctl"
    },

    "cpu": {
        "format": "cpu {usage}%",
        "on-click": "ghostty -e btop"
    },

    "memory": {
        "format": "mem {percentage}%",
        "on-click": "ghostty -e btop"
    },

    "backlight": {
        "format": "light {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "bat {capacity}%",
        "format-charging": "bat +{capacity}%"
    },

    "tray": {
        "spacing": 8
    }
}
